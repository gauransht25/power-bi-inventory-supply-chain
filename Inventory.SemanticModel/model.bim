      {
        "name": "Inventory",
        "columns": [
          {
            "name": "Month",
            "sourceColumn": "Month",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "Region",
            "sourceColumn": "Region",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "SKU",
            "sourceColumn": "SKU",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "On Hand",
            "sourceColumn": "On Hand",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "Reorder Floor",
            "sourceColumn": "Reorder Floor",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "Stock Value",
            "sourceColumn": "Stock Value",
            "dataType": "int64",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Inventory Value",
            "expression": "VAR AsOf = MAX(Inventory[Month]) RETURN CALCULATE(SUM(Inventory[Stock Value]), Inventory[Month] = AsOf)",
            "formatString": "\"INR \"#,0"
          },
          {
            "name": "On Hand Units",
            "expression": "VAR AsOf = MAX(Inventory[Month]) RETURN CALCULATE(SUM(Inventory[On Hand]), Inventory[Month] = AsOf)",
            "formatString": "#,0"
          },
          {
            "name": "Below Reorder",
            "expression": "VAR AsOf = MAX(Inventory[Month]) RETURN COUNTROWS(FILTER(Inventory, Inventory[Month] = AsOf && Inventory[On Hand] < Inventory[Reorder Floor])) + 0",
            "formatString": "#,0"
          },
          {
            "name": "Reorder Floor Units",
            "expression": "VAR AsOf = MAX(Inventory[Month]) RETURN CALCULATE(SUM(Inventory[Reorder Floor]), Inventory[Month] = AsOf)",
            "formatString": "#,0"
          }
        ],
